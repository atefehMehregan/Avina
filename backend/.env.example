# ============================================================================
# نمونه تنظیمات محیط — این فایل نمونه است و هیچ راز واقعی ندارد.
# برای اجرا یک کپی به نام .env بسازید و مقدارها را پر کنید.
# فایل .env هرگز نباید در گیت باشد (در .gitignore هست).
# ============================================================================

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------- پایگاه داده
# رشته اتصال PostgreSQL. هیچ‌وقت داخل کد نوشته نمی‌شود.
# نمونه Supabase (از بخش Connection string → URI بردارید):
#   postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# نمونه Neon / Render:
#   postgresql://user:PASSWORD@host/dbname
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# SSL: خالی بگذارید تا خودکار تصمیم بگیرد (در تولید روشن با بررسی گواهی).
#   on         → روشن، گواهی بررسی می‌شود (پیش‌فرض تولید)
#   no-verify  → روشن، ولی بدون بررسی گواهی. فقط اگر ارائه‌دهنده گواهی
#                خودامضا می‌دهد. جلوی حمله مرد-میانی را باز می‌گذارد.
#   off        → خاموش (فقط PostgreSQL محلی)
DATABASE_SSL=

# بیشینه اتصال‌های استخر. روی پلن رایگان ابری معمولا کم بگذارید.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- آزمون
# آزمون‌ها پیش‌فرض روی PGlite (PostgreSQL روی WASM، بدون نصب) اجرا می‌شوند.
# اگر می‌خواهید روی یک PostgreSQL واقعیِ آزمایشی اجرا شوند این را بدهید.
# هرگز رشته اتصال تولید را اینجا نگذارید.
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/avina_test

# ------------------------------------------------------------------ CORS
# مبداهایی که اجازه دارند با کوکی درخواست بدهند — با کاما جدا شوند.
# هرگز * نگذارید؛ درخواست‌ها کوکی‌دار هستند.
ALLOWED_ORIGINS=https://atefehmehregan.github.io,http://localhost:8080

# ---------------------------------------------------------------- کوکی‌ها
SESSION_COOKIE_NAME=avina_session
CSRF_COOKIE_NAME=avina_csrf
SESSION_DAYS=30

# اگر API روی زیردامنه خودتان است می‌توانید دامنه کوکی را تعیین کنید،
# مثلا .avina.ir — روی github.io خالی بگذارید.
COOKIE_DOMAIN=

# ------------------------------------------------------------- Argon2id
ARGON_MEMORY_KIB=19456
ARGON_TIME=2
ARGON_PARALLELISM=1
